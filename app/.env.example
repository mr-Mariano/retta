# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. The seed script reads it from .env.seed.local; the agent needs it
# in Vercel (already set by the Supabase integration). Never expose it to the client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Seed script only, in .env.seed.local:
# SEED_PASSWORD=shared-password-for-demo-accounts

# Agente Retta (server only). The cron secret must match the agent_tick_secret
# stored in Supabase Vault. Without AGENT_LLM_API_KEY the agent uses its rules.
AGENT_CRON_SECRET=
AGENT_LLM_API_KEY=
# Optional: any OpenAI-compatible provider (defaults to Gemini's free tier).
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
# Used when AGENT_LLM_MODEL is busy (429/5xx); defaults to gemini-flash-lite-latest.
AGENT_LLM_FALLBACK_MODEL=
